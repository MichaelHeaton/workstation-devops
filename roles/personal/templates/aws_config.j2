# Managed by workstation-devops (roles/personal, `aws` tag) from group_vars/personal.yml.
# SSO only, no static keys. Break-glass use only: see docs/home/aws-break-glass.md.
# Do not run `aws configure` or `aws configure sso`; they rewrite this file. Edit the vars instead.

[default]
{% for p in personal_aws_profiles | default([]) %}

[profile {{ p.name }}]
region = {{ p.region | default(personal_aws_region) }}
output = {{ p.output | default('json') }}
sso_session = {{ p.sso_session }}
sso_account_id = {{ p.sso_account_id }}
sso_role_name = {{ p.sso_role_name }}
{% endfor %}
{% for s in personal_aws_sso_sessions | default([]) %}

[sso-session {{ s.name }}]
sso_start_url = {{ s.start_url }}
sso_region = {{ s.region | default(personal_aws_region) }}
sso_registration_scopes = {{ s.registration_scopes | default('sso:account:access') }}
{% endfor %}
