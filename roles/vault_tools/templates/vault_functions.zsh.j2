{%- macro alias_name(cluster) -%}
{%- set slug = cluster.label | lower | replace('-', '_') -%}
{%- if slug.startswith('vault') -%}
{{ slug }}
{%- else -%}
vault_{{ slug }}
{%- endif -%}
{%- endmacro -%}
# Vault / Teleport CLI helpers — workstation-devops (work profile)
# Wiki: Vault Engineer Onboarding → Tips/Shortcuts → Bash Functions and Aliases
# Auth: vl (adobe-security-tooling/vaultlogin) — OIDC, driven by VAULT_ADDR/VAULT_NAMESPACE.
# Requires: vl, vault, tsh on PATH; VPN for corp clusters

# --- Per-cluster login aliases (wiki: vault_login; generated from vault_clusters) --
# Add/edit clusters in group_vars/work.local.yml — see work.local.yml.example
# Optional per-cluster keys: tier (dev|prod, default dev); indent: true marks a
# cluster as a mirror of the previous non-indented entry — used by mytools.
# Alias name is vault_<label lowercased, - → _> — unless the label already
# starts with "vault" (e.g. VAULT-A), in which case the prefix isn't doubled.
{%- for cluster in vault_clusters %}
alias {{ alias_name(cluster) }}='export VAULT_ADDR={{ cluster.url }} VAULT_NAMESPACE={{ cluster.namespace | default("root") }} && unset VAULT_TOKEN && vl'
{%- endfor %}

# Ordered cluster list + tier/indent metadata, consumed by mytools (roles/shell)
# to display clusters in vault_clusters order (not alphabetical) with tier
# coloring and mirror indentation. Falls back to plain alphabetical listing if
# undefined.
typeset -ga VAULT_TOOLS_CLUSTER_ALIASES=(
{%- for cluster in vault_clusters %}
  "{{ alias_name(cluster) }}"
{%- endfor %}
)
typeset -gA VAULT_TOOLS_CLUSTER_TIER=(
{%- for cluster in vault_clusters %}
  {{ alias_name(cluster) }} "{{ cluster.tier | default('dev') }}"
{%- endfor %}
)
typeset -gA VAULT_TOOLS_CLUSTER_INDENT=(
{%- for cluster in vault_clusters %}
{%- if cluster.indent | default(false) %}
  {{ alias_name(cluster) }} "true"
{%- endif %}
{%- endfor %}
)

# --- Vault MGMT (Teleport app vault-mgmt-access) -----------------------------

vault_mgmt() {
  echo "Logging into Teleport app 'vault-mgmt-access'..."
  if ! tsh app login vault-mgmt-access > /dev/null 2>&1; then
    echo "Error: Teleport app login failed." >&2
    return 1
  fi

  echo "Starting Teleport tunnel on port 8222..."
  tsh proxy app vault-mgmt-access -p 8222 &
  local PROXY_PID=$!
  sleep 2

  export VAULT_ADDR="http://127.0.0.1:8222"
  export VAULT_NAMESPACE="root"
  unset VAULT_TOKEN
  echo "VAULT_ADDR set to ${VAULT_ADDR}"

  if ! vl; then
    echo "Error: Vault login failed." >&2
    kill $PROXY_PID
    return 1
  fi

  echo "Vault auth succeeded. Tunnel active (PID: $PROXY_PID). Auto-closes in 4 hours."
  ( sleep 14400 && echo "4 hours elapsed — closing tunnel (PID: $PROXY_PID)..." && kill $PROXY_PID ) &
}
