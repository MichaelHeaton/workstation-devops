# Shared shell exports (workstation-devops)
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"
[[ -f "$HOME/.config/ai-skills/accounts.shell" ]] && source "$HOME/.config/ai-skills/accounts.shell"

mytools() {
  echo ""
  local found=0

  if (( $+functions[ces_sandbox] || $+functions[ces_dev] || $+functions[ces_prd] )); then
    echo "  ── AWS (KLAM) ───────────────────────────────────────────────────"
    (( $+functions[ces_sandbox] )) && echo "    ces_sandbox         assume KLAM credentials for sandbox  (...3550)"
    (( $+functions[ces_dev] ))     && echo "    ces_dev             assume KLAM credentials for dev       (...9010)"
    (( $+functions[ces_prd] ))     && echo "    ces_prd             assume KLAM credentials for prod      (...1222)"
    echo "    ces_term_reset      disconnect — unset AWS_PROFILE + reset terminal colors"
    echo ""
    found=1
  fi

  if (( $+functions[platform_bootstrap] )); then
    echo "  ── Personal AWS ─────────────────────────────────────────────────"
    echo "    platform_bootstrap  re-export AWS_PROFILE + region + tfstate bucket"
    echo ""
    found=1
  fi

  if (( $+commands[vl] || $+functions[vault_mgmt] )); then
    echo "  ── Vault ────────────────────────────────────────────────────────"
    if (( $+commands[vl] )); then
      local -a vault_cluster_aliases
      for a in ${(ok)aliases}; do
        [[ $a == vault_* ]] && vault_cluster_aliases+=("$a")
      done
      if (( $#vault_cluster_aliases )); then
        echo "    ${(j:, :)vault_cluster_aliases}"
        echo "                        → VAULT_ADDR/NAMESPACE + OIDC login via vl (see docs/work/vault-tools.md)"
      else
        echo "    vl                  OIDC login (export VAULT_ADDR/VAULT_NAMESPACE first)"
      fi
    fi
    (( $+functions[vault_mgmt] ))  && echo "    vault_mgmt          Teleport vault-mgmt-access → local proxy :8222"
    echo ""
    found=1
  fi

  if (( $+aliases[vssh] || $+functions[t] || $+functions[tshl] )); then
    echo "  ── Teleport ─────────────────────────────────────────────────────"
    (( $+aliases[vssh] ))  && echo "    vssh                tsh ssh with --request-reason='Vault admin'"
    (( $+functions[t] ))   && echo "    t                   interactive cluster/node picker (fzf)"
    (( $+functions[tshl] )) && echo "    tshl                Teleport SSH helper"
    echo ""
    found=1
  fi

  if (( found == 0 )); then
    echo "  No workstation-devops tools detected in current shell."
    echo "  Run: make apply TAGS=shell  (from ~/Projects/personal/workstation-devops)"
    echo ""
  fi
}
