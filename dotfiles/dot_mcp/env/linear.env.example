# ~/.mcp/env/linear.env — Linear MCP server credentials
# This MCP uses macOS Keychain — no env file needed at runtime.
# To store or update your key:
#   security add-generic-password -s "claude-mcp-linear" -a "claude-code" -w "YOUR_KEY"
#
# Get your API key at: https://linear.app/settings/api
# "Personal API keys" section → create new key
LINEAR_API_KEY=your_key_here
LINEAR_TEAM_NAME=SpecterRealm
