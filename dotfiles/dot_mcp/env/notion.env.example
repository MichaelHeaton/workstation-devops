# ~/.mcp/env/notion.env — Notion MCP server credentials
# This MCP uses macOS Keychain — no env file needed at runtime.
# To store or update your token:
#   security add-generic-password -s "claude-mcp-notion" -a "claude-code" -w "YOUR_TOKEN"
#
# Get your token at: https://www.notion.so/my-integrations
# Create a new integration → copy the "Internal Integration Token"
NOTION_API_TOKEN=your_token_here
