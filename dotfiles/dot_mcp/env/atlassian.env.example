# ~/.mcp/env/atlassian-config.env — Atlassian MCP non-secret config
# This file contains URLs and usernames only — no API tokens.
# Tokens are stored in macOS Keychain; see make secrets-atlassian.
#
# Setup (run once per machine):
#   make secrets-atlassian
#
# This creates this config file AND stores tokens in Keychain:
#   service=claude-mcp-atlassian-jira,       account=claude-code  (Jira token)
#   service=claude-mcp-atlassian-confluence,  account=claude-code  (Confluence token)
#
# Get tokens at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://jira.internal.example
CONFLUENCE_URL=https://wiki.internal.example
JIRA_USERNAME=your_ldap@work.example
CONFLUENCE_USERNAME=your_ldap@work.example
