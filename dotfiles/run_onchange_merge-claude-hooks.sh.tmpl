#!/usr/bin/env bash
# merge-claude-hooks — register ai-skills hook scripts in ~/.claude/settings.json.
#
# ADDITIVE ONLY: installs Read (block-env-read), UserPromptSubmit (lean-context),
# SessionStart (check-ai-skills-sync), and PostToolUse (config-capture-watch)
# hooks when missing. Hook scripts are deployed by ai-skills make install-system.
#
# Bump to force re-run:
# hooks-policy-version: v1.2.0

set -euo pipefail

SETTINGS="$HOME/.claude/settings.json"
BLOCK_ENV="$HOME/.claude/hooks/block-env-read.py"
LEAN_CTX="$HOME/.claude/hooks/lean-context-reminder.py"
SYNC_CHECK="$HOME/.claude/hooks/check-ai-skills-sync.py"
CONFIG_CAPTURE="$HOME/.claude/hooks/config-capture-watch.py"

if [[ ! -f "$SETTINGS" ]]; then
  echo "merge-claude-hooks: $SETTINGS not found, skipping"
  exit 0
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "WARN: merge-claude-hooks: jq not installed, skipping" >&2
  exit 0
fi

PYTHON_BIN=$(command -v python3)

READ_HOOK='{
  "matcher": "Read",
  "hooks": [
    {
      "type": "command",
      "command": "__PYTHON__ __BLOCK_ENV__"
    }
  ]
}'

PROMPT_HOOK='{
  "matcher": "",
  "hooks": [
    {
      "type": "command",
      "command": "__PYTHON__ __LEAN_CTX__"
    }
  ]
}'

SESSION_HOOK='{
  "matcher": "",
  "hooks": [
    {
      "type": "command",
      "command": "__PYTHON__ __SYNC_CHECK__"
    }
  ]
}'

CONFIG_CAPTURE_HOOK='{
  "matcher": "Edit|Write",
  "hooks": [
    {
      "type": "command",
      "command": "__PYTHON__ __CONFIG_CAPTURE__"
    }
  ]
}'

READ_HOOK="${READ_HOOK//__PYTHON__/$PYTHON_BIN}"
READ_HOOK="${READ_HOOK//__BLOCK_ENV__/$BLOCK_ENV}"
PROMPT_HOOK="${PROMPT_HOOK//__PYTHON__/$PYTHON_BIN}"
PROMPT_HOOK="${PROMPT_HOOK//__LEAN_CTX__/$LEAN_CTX}"
SESSION_HOOK="${SESSION_HOOK//__PYTHON__/$PYTHON_BIN}"
SESSION_HOOK="${SESSION_HOOK//__SYNC_CHECK__/$SYNC_CHECK}"
CONFIG_CAPTURE_HOOK="${CONFIG_CAPTURE_HOOK//__PYTHON__/$PYTHON_BIN}"
CONFIG_CAPTURE_HOOK="${CONFIG_CAPTURE_HOOK//__CONFIG_CAPTURE__/$CONFIG_CAPTURE}"

if [[ ! -f "$BLOCK_ENV" ]]; then
  echo "merge-claude-hooks: $BLOCK_ENV missing (run ai-skills make install-system), skipping Read hook"
  READ_HOOK=""
fi

if [[ ! -f "$LEAN_CTX" ]]; then
  echo "merge-claude-hooks: $LEAN_CTX missing (run ai-skills make install-system), skipping UserPromptSubmit hook"
  PROMPT_HOOK=""
fi

if [[ ! -f "$SYNC_CHECK" ]]; then
  echo "merge-claude-hooks: $SYNC_CHECK missing (run ai-skills make install-system), skipping SessionStart hook"
  SESSION_HOOK=""
fi

if [[ ! -f "$CONFIG_CAPTURE" ]]; then
  echo "merge-claude-hooks: $CONFIG_CAPTURE missing (run ai-skills make install-system), skipping PostToolUse hook"
  CONFIG_CAPTURE_HOOK=""
fi

has_read=$(jq '[.hooks.PreToolUse[]? | select(.matcher == "Read")] | length' "$SETTINGS")
if [[ -n "$READ_HOOK" && "$has_read" -eq 0 ]]; then
  echo "merge-claude-hooks: adding Read PreToolUse hook (block-env-read)..."
  tmp=$(mktemp)
  jq --argjson hook "$READ_HOOK" \
    '.hooks.PreToolUse = ((.hooks.PreToolUse // []) + [$hook])' \
    "$SETTINGS" > "$tmp" && mv "$tmp" "$SETTINGS"
  echo "  done"
elif [[ "$has_read" -gt 0 ]]; then
  echo "merge-claude-hooks: Read hook already present, skipping"
fi

has_prompt=$(jq '[.hooks.UserPromptSubmit[]? | select(.matcher == "")] | length' "$SETTINGS")
if [[ -n "$PROMPT_HOOK" && "$has_prompt" -eq 0 ]]; then
  echo "merge-claude-hooks: adding UserPromptSubmit hook (lean-context-reminder)..."
  tmp=$(mktemp)
  jq --argjson hook "$PROMPT_HOOK" \
    '.hooks.UserPromptSubmit = ((.hooks.UserPromptSubmit // []) + [$hook])' \
    "$SETTINGS" > "$tmp" && mv "$tmp" "$SETTINGS"
  echo "  done"
elif [[ "$has_prompt" -gt 0 ]]; then
  echo "merge-claude-hooks: UserPromptSubmit hook already present, skipping"
fi

has_session=$(jq '[.hooks.SessionStart[]? | select(.matcher == "")] | length' "$SETTINGS")
if [[ -n "$SESSION_HOOK" && "$has_session" -eq 0 ]]; then
  echo "merge-claude-hooks: adding SessionStart hook (check-ai-skills-sync)..."
  tmp=$(mktemp)
  jq --argjson hook "$SESSION_HOOK" \
    '.hooks.SessionStart = ((.hooks.SessionStart // []) + [$hook])' \
    "$SETTINGS" > "$tmp" && mv "$tmp" "$SETTINGS"
  echo "  done"
elif [[ "$has_session" -gt 0 ]]; then
  echo "merge-claude-hooks: SessionStart hook already present, skipping"
fi

has_config_capture=$(jq '[.hooks.PostToolUse[]? | select(.matcher == "Edit|Write")] | length' "$SETTINGS")
if [[ -n "$CONFIG_CAPTURE_HOOK" && "$has_config_capture" -eq 0 ]]; then
  echo "merge-claude-hooks: adding PostToolUse hook (config-capture-watch)..."
  tmp=$(mktemp)
  jq --argjson hook "$CONFIG_CAPTURE_HOOK" \
    '.hooks.PostToolUse = ((.hooks.PostToolUse // []) + [$hook])' \
    "$SETTINGS" > "$tmp" && mv "$tmp" "$SETTINGS"
  echo "  done"
elif [[ "$has_config_capture" -gt 0 ]]; then
  echo "merge-claude-hooks: PostToolUse hook already present, skipping"
fi

echo "merge-claude-hooks: done"
