# Copy to group_vars/work.local.yml (gitignored) on work machines.
# Holds employer-specific URLs and repos — not committed to the public repo.
#
#   cp group_vars/work.local.yml.example group_vars/work.local.yml
#   # edit values, then make apply

# --- Managed repos (work-only clones) ----------------------------------------
managed_repos_local:
  # optional: true — won't fail make apply when VPN is off or repo unreachable
  - repo: https://github.com/YOUR_ORG/cursor-rules.git
    dest: work/cursor-rules
    optional: true

# --- KLAM Artifactory pip index ----------------------------------------------
klam_artifactory_host: artifactory.internal.example
klam_artifactory_pypi_path: artifactory/api/pypi/pypi-klam-cli-release/simple

# --- Vault cluster aliases (vl aliases: vault_dev_amer, vault_test, etc.) ----
# namespace defaults to "root" — set it per-cluster only if a cluster needs something else.
# tier: dev|prod (default dev) — controls mytools color (green/red) and puts dev-tier
#   clusters first, matching the ces_sandbox/ces_dev/ces_prd ordering convention.
# indent: true — marks a cluster as a mirror of the entry above it (e.g. a regional
#   replica), indenting it slightly in mytools output.
vault_clusters:
  - label: VII-DEV
    url: https://vault-vii.dev.internal.example
    tier: dev
  - label: VII-DEV-INT
    url: https://vault-int-vii.dev.internal.example
    tier: dev
    # namespace: root   # example override
    # Requires the VII-internal MCP network — drop this entry if your machine can't reach it.
  - label: TEST
    url: https://vault-test.dev.internal.example
    tier: dev
  - label: DEV-AMER
    url: https://vault-amer.dev.internal.example
    tier: dev
  - label: VAULT-A-DEV
    url: https://vault.dev.internal.example
    tier: dev
  - label: PROD-AMER
    url: https://vault-amer.internal.example
    tier: prod
  - label: PROD-APAC
    url: https://vault-apac.internal.example
    tier: prod
    indent: true   # mirrors PROD-AMER
  - label: PROD-EMEA
    url: https://vault-emea.internal.example
    tier: prod
    indent: true   # mirrors PROD-AMER
  - label: TRANSIT
    url: https://vault-transit-amer.internal.example
    tier: prod
  - label: VAULT-A
    url: https://vault.internal.example
    tier: prod
